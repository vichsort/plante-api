# Banco
DB_HOST=localhost
DB_PORT=5432
DB_USER=plante_user
DB_PASSWORD=your_password_here
DB_NAME=plante_db

# Redis
REDIS_USER=default
REDIS_PASSWORD=your_redis_password_here
REDIS_ENDPOINT=localhost
REDIS_PORT=6379
# Timeouts (s) do cliente Redis compartilhado; aumente se o Redis for remoto/alta latência
# REDIS_SOCKET_TIMEOUT_SECONDS=0.5
# REDIS_CONNECT_TIMEOUT_SECONDS=0.5

# IA
GEMINI_API_KEY=your_gemini_api_key_here
KINDWISE_API_KEY=your_kindwise_api_key_here
PLANTNET_API_KEY=your_plantnet_api_key_here
# Circuit breaker dos provedores de IA: falhas seguidas até abrir e segundos até tentar de novo
# AI_BREAKER_FAILURE_THRESHOLD=5
# AI_BREAKER_RECOVERY_TIMEOUT_SECONDS=30

# Proxy reverso / load balancer
# IPs ou faixas CIDR (separados por vírgula) autorizados a enviar X-Forwarded-For; sem isso o
# rate limit vê todos os clientes com o IP do balanceador. Lido pelo uvicorn direto do ambiente
# do processo (não pelo Settings): passe-o ao container. Padrão do uvicorn: 127.0.0.1.
# "*" só se a API não for acessível sem o balanceador.
# FORWARDED_ALLOW_IPS=172.16.0.0/12

# Auth
SECRET_KEY=your_secret_key_here
JWT_ALGORITHM=HS256

# Image storage: `local` keeps the photos in a folder of the server and the API serves them through
# signed links; `s3` is any S3-compatible storage (AWS, or Cloudflare R2 with S3_ENDPOINT_URL and
# AWS_REGION=auto). With `local`, back up the folder: the training dataset lives there too.
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=data/images
# Address the client uses to reach the API (the local image links point to it)
PUBLIC_API_URL=http://localhost:8000
# How long an image link lasts, in seconds
# IMAGE_LINK_TTL_SECONDS=3600

# AWS
AWS_REGION=us-east-1
S3_BUCKET=plante-bucket-name
# S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
SES_SENDER_EMAIL=noreply@yourdomain.com

# App
DEBUG=false
CONSENSUS_ENABLED=true
LOCAL_TIMEZONE=America/Sao_Paulo

# Quota: standard is everyone's (raise it as donations cover the costs); extended is granted
# by the maintainer, by request. Extended cannot be below standard.
QUOTA_STANDARD_MAX_PLANTS=3
QUOTA_STANDARD_DAILY_TOKENS=3
QUOTA_EXTENDED_MAX_PLANTS=10
QUOTA_EXTENDED_DAILY_TOKENS=10
