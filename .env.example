# Banco
DB_HOST=localhost
DB_PORT=5432
DB_USER=plante_user
DB_PASSWORD=your_password_here
DB_NAME=plante_db

# Redis
REDIS_USER=default
REDIS_PASSWORD=your_redis_password_here
REDIS_ENDPOINT=localhost
REDIS_PORT=6379

# IA
GEMINI_API_KEY=your_gemini_api_key_here
KINDWISE_API_KEY=your_kindwise_api_key_here
PLANTNET_API_KEY=your_plantnet_api_key_here

# Proxy reverso / load balancer
# IPs (separados por vírgula) autorizados a enviar X-Forwarded-For; sem isso o rate limit
# vê todos os clientes com o IP do balanceador. Lido pelo uvicorn direto do ambiente do
# processo (não pelo Settings): passe-o ao container. Padrão do uvicorn: 127.0.0.1.
# uvicorn 0.30 aceita só IPs exatos ou "*" (sem CIDR); "*" só se a API não for acessível sem o balanceador.
# FORWARDED_ALLOW_IPS=10.0.1.15,10.0.2.15

# Auth
SECRET_KEY=your_secret_key_here
JWT_ALGORITHM=HS256

# AWS
AWS_REGION=us-east-1
S3_BUCKET=plante-bucket-name
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
SES_SENDER_EMAIL=noreply@yourdomain.com

# Firebase
GOOGLE_APPLICATION_CREDENTIALS=path/to/firebase_credentials.json

# App
DEBUG=false
CONSENSUS_ENABLED=true